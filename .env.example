# CollegeFootballData.com API key — https://collegefootballdata.com/key
CFBD_API_KEY=

# SMTP credentials for weekly report delivery (e.g. a Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Comma-separated list of report recipients
REPORT_RECIPIENTS=

# Google Drive delivery (alternative/additional to email) — service account auth.
# One-time setup:
#   1. https://console.cloud.google.com/projectcreate — create a project (or reuse one).
#   2. https://console.cloud.google.com/apis/library/drive.googleapis.com — enable the
#      Google Drive API for that project.
#   3. https://console.cloud.google.com/iam-admin/serviceaccounts — create a service
#      account (e.g. "cfb-analytics-uploader"). No roles needed at the project level.
#   4. On that service account -> Keys -> Add Key -> Create new key -> JSON. Save the
#      downloaded file as credentials/google-drive-service-account.json (gitignored —
#      never commit it).
#   5. Copy the service account's email (looks like
#      cfb-analytics-uploader@<project>.iam.gserviceaccount.com) — find it on the
#      service account's detail page.
#   6. In Google Drive, share your target folder with that email as Editor (Content
#      Manager) — a service account can only see/upload to folders explicitly shared
#      with it.
#   7. Open the folder in Drive; copy the folder ID from the URL
#      (drive.google.com/drive/folders/<FOLDER_ID>) into GOOGLE_DRIVE_FOLDER_ID below.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=credentials/google-drive-service-account.json
GOOGLE_DRIVE_FOLDER_ID=
